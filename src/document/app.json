{
    "component": "app",
    "_title": "Northwind Ops",
    "toasts": {
        "component": "toastRegion",
        "position": "bottomEnd",
        "max": 3,
        "_label": "Notifications",
        "messages": {
            "orderCreated": {
                "tone": "success",
                "_title": "Order created",
                "_text": "The new order is at the end of the list."
            },
            "orderCancelled": {
                "tone": "warning",
                "_title": "Order cancelled",
                "_text": "The customer will be notified."
            },
            "orderShipped": {
                "tone": "success",
                "_title": "Order shipped",
                "_text": "The status is now shipped."
            },
            "refreshed": {
                "tone": "info",
                "_title": "Orders refreshed",
                "_text": "The list is up to date."
            },
            "help": {
                "tone": "info",
                "_title": "How it works",
                "_text": "Buttons write to the store; components follow the data."
            },
            "signedOut": {
                "tone": "neutral",
                "_title": "Signed out",
                "_text": "Not really: this is a demo."
            },
            "agent": {
                "tone": "accent",
                "_title": "Message from the agent",
                "_text": "This toast was requested by writing to the store."
            },
            "orderMoved": {
                "tone": "info",
                "_title": "Order moved",
                "_text": "The status follows the column."
            },
            "settingsSaved": {
                "tone": "success",
                "_title": "Settings saved",
                "_text": "Your profile is up to date."
            },
            "noteSaved": {
                "tone": "success",
                "_title": "Note saved",
                "_text": "Only your team can see it."
            },
            "productSaved": {
                "tone": "success",
                "_title": "Product saved",
                "_text": "The catalogue is up to date."
            },
            "productDeleted": {
                "tone": "warning",
                "_title": "Product deleted",
                "_text": "It is gone from the catalogue."
            },
            "supportSent": {
                "tone": "success",
                "_title": "Message sent",
                "_text": "Support answers within one working day."
            },
            "uploaded": {
                "tone": "success",
                "_title": "File attached",
                "_text": "The file stays in this browser tab."
            }
        }
    }
}
