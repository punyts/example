{
    "effects": {
        "fetchArchive": {
            "request": "$.data.archive.request",
            "run": "$.functions.host.archiveFetch",
            "status": "$.data.archive.status",
            "records": {
                "into": "$.data.archive.records",
                "key": "id"
            },
            "window": "$.data.archive.page",
            "cache": 10
        }
    },
    "computes": {
        "archiveTotal": {
            "inputs": {
                "amount": "$.data.archive.records.{id}.total"
            },
            "run": "$.functions.host.moneyFormat",
            "outputs": {
                "text": "$.data.archive.records.{id}.totalText"
            }
        }
    },
    "tables": {
        "archiveStatus": {
            "inputs": {
                "state": {
                    "path": "$.data.archive.status.state",
                    "values": [
                        "idle",
                        "loading",
                        "ready",
                        "error"
                    ]
                }
            },
            "outputs": {
                "text": "$.data.archive.view.statusText",
                "tone": "#archiveStatus.tone",
                "loading": "$.data.archive.view.loading"
            },
            "rows": [
                {
                    "state": "idle",
                    "text": "Not loaded",
                    "tone": "neutral",
                    "loading": false
                },
                {
                    "state": "loading",
                    "text": "Loading",
                    "tone": "info",
                    "loading": true
                },
                {
                    "state": "ready",
                    "text": "Up to date",
                    "tone": "success",
                    "loading": false
                },
                {
                    "state": "error",
                    "text": "Failed",
                    "tone": "danger",
                    "loading": false
                }
            ]
        },
        "ridgelineStatus": {
            "inputs": {
                "winner": {
                    "path": "$.data.game.board.winner",
                    "values": [
                        "none",
                        "amber",
                        "teal",
                        "draw"
                    ]
                },
                "turn": {
                    "path": "$.data.game.board.turn",
                    "values": [
                        "amber",
                        "teal"
                    ]
                },
                "reason": {
                    "path": "$.data.game.board.reason",
                    "values": [
                        "beacon",
                        "scouts",
                        "stuck",
                        "limit",
                        "*"
                    ]
                }
            },
            "outputs": {
                "amberTurn": "#amberTurn.hidden",
                "tealTurn": "#tealTurn.hidden",
                "amberWon": "#amberWon.hidden",
                "tealWon": "#tealWon.hidden",
                "drawn": "#drawn.hidden",
                "byBeacon": "#byBeacon.hidden",
                "byScouts": "#byScouts.hidden",
                "byStuck": "#byStuck.hidden",
                "byLimit": "#byLimit.hidden"
            },
            "rows": [
                {
                    "winner": "none",
                    "turn": "amber",
                    "amberTurn": false,
                    "tealTurn": true,
                    "amberWon": true,
                    "tealWon": true,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": true
                },
                {
                    "winner": "none",
                    "turn": "teal",
                    "amberTurn": true,
                    "tealTurn": false,
                    "amberWon": true,
                    "tealWon": true,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": true
                },
                {
                    "winner": "amber",
                    "reason": "beacon",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": false,
                    "tealWon": true,
                    "drawn": true,
                    "byBeacon": false,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": true
                },
                {
                    "winner": "amber",
                    "reason": "scouts",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": false,
                    "tealWon": true,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": false,
                    "byStuck": true,
                    "byLimit": true
                },
                {
                    "winner": "amber",
                    "reason": "stuck",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": false,
                    "tealWon": true,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": false,
                    "byLimit": true
                },
                {
                    "winner": "amber",
                    "reason": "limit",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": false,
                    "tealWon": true,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": false
                },
                {
                    "winner": "teal",
                    "reason": "beacon",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": true,
                    "tealWon": false,
                    "drawn": true,
                    "byBeacon": false,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": true
                },
                {
                    "winner": "teal",
                    "reason": "scouts",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": true,
                    "tealWon": false,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": false,
                    "byStuck": true,
                    "byLimit": true
                },
                {
                    "winner": "teal",
                    "reason": "stuck",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": true,
                    "tealWon": false,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": false,
                    "byLimit": true
                },
                {
                    "winner": "teal",
                    "reason": "limit",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": true,
                    "tealWon": false,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": false
                },
                {
                    "winner": "draw",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": true,
                    "tealWon": true,
                    "drawn": false,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": false
                },
                {
                    "winner": "*",
                    "turn": "*",
                    "reason": "*",
                    "amberTurn": true,
                    "tealTurn": true,
                    "amberWon": true,
                    "tealWon": true,
                    "drawn": true,
                    "byBeacon": true,
                    "byScouts": true,
                    "byStuck": true,
                    "byLimit": true
                }
            ]
        }
    },
    "rules": {
        "archivePage": {
            "when": {
                "path": "$.screens.main.children.archive.children.pager.page"
            },
            "do": [
                {
                    "command": "set",
                    "target": "$.data.archive.request.page",
                    "value": "{{ $trigger }}"
                }
            ]
        },
        "ridgelinePick": {
            "when": {
                "path": "$.data.game.input.pick"
            },
            "do": [
                {
                    "command": "set",
                    "target": "$.data.game.board",
                    "value": "{{ $.functions.host.ridgelinePick($.data.game.board, $trigger) }}"
                },
                {
                    "command": "set",
                    "target": "$.data.game.input.pick",
                    "value": ""
                }
            ]
        },
        "ridgelineMove": {
            "when": {
                "path": "$.data.game.input.to"
            },
            "do": [
                {
                    "command": "set",
                    "target": "$.data.game.board",
                    "value": "{{ $.functions.host.ridgelineMove($.data.game.board, $trigger) }}"
                },
                {
                    "command": "set",
                    "target": "$.data.game.input.to",
                    "value": ""
                }
            ]
        },
        "ridgelineNew": {
            "when": {
                "path": "$.data.game.input.reset"
            },
            "do": [
                {
                    "command": "set",
                    "target": "$.data.game.board",
                    "value": "{{ $.functions.host.ridgelineNew($.data.game.board, $trigger) }}"
                },
                {
                    "command": "set",
                    "target": "$.data.game.input.reset",
                    "value": false
                }
            ]
        },
        "orchardCatch": {
            "when": {
                "path": "$.raised.screens.main.children.orchard.children.field.children.scene.children.basket.contact",
                "if": "$trigger.repeat == 'fruit'"
            },
            "do": [
                {
                    "command": "increment",
                    "target": "$.data.orchard.score"
                },
                {
                    "command": "delete-data",
                    "target": "$.data.orchard.fruit.{{ $trigger.with }}"
                }
            ]
        },
        "orchardMiss": {
            "when": {
                "path": "$.raised.screens.main.children.orchard.children.field.children.scene.children.ground.contact",
                "if": "$trigger.repeat == 'fruit'"
            },
            "do": [
                {
                    "command": "increment",
                    "target": "$.data.orchard.missed"
                },
                {
                    "command": "delete-data",
                    "target": "$.data.orchard.fruit.{{ $trigger.with }}"
                }
            ]
        },
        "orchardOver": {
            "when": {
                "path": "$.data.orchard.missed",
                "if": "$trigger >= 5"
            },
            "do": [
                {
                    "command": "set",
                    "target": "$.data.orchard.play.running",
                    "value": false
                },
                {
                    "command": "set",
                    "target": "#over.hidden",
                    "value": false
                }
            ]
        },
        "orchardReset": {
            "when": {
                "path": "$.data.orchard.reset",
                "is": true
            },
            "do": [
                {
                    "command": "set",
                    "target": "$.data.orchard.play.running",
                    "value": false
                },
                {
                    "command": "set",
                    "target": "$.data.orchard.fruit",
                    "value": {}
                },
                {
                    "command": "set",
                    "target": "$.data.orchard.score",
                    "value": 0
                },
                {
                    "command": "set",
                    "target": "$.data.orchard.missed",
                    "value": 0
                },
                {
                    "command": "set",
                    "target": "#over.hidden",
                    "value": true
                },
                {
                    "command": "set",
                    "target": "$.data.orchard.reset",
                    "value": false
                }
            ]
        },
        "workshopOperation": {
            "when": {
                "path": "$.data.workshop.input.op",
                "if": "$trigger != ''"
            },
            "do": [
                {
                    "command": "increment",
                    "target": "$.data.workshop.count"
                },
                {
                    "command": "set",
                    "target": "$.data.workshop.request",
                    "value": {
                        "op": "$trigger",
                        "n": "$.data.workshop.count"
                    }
                },
                {
                    "command": "set",
                    "target": "$.data.workshop.input.op",
                    "value": ""
                }
            ]
        },
        "workshopSave": {
            "when": {
                "path": "$.data.workshop.input.save",
                "is": true
            },
            "do": [
                {
                    "command": "increment",
                    "target": "$.data.workshop.count"
                },
                {
                    "command": "set",
                    "target": "$.data.workshop.exportRequest",
                    "value": "$.data.workshop.count"
                },
                {
                    "command": "set",
                    "target": "$.data.workshop.input.save",
                    "value": false
                }
            ]
        }
    },
    "machines": {
        "orchardDrop": {
            "state": "$.data.orchard.phase",
            "initial": "idle",
            "transitions": [
                {
                    "from": "idle",
                    "when": {
                        "path": "$.data.orchard.play.running",
                        "is": true
                    },
                    "to": "dropping"
                },
                {
                    "from": "dropping",
                    "when": {
                        "path": "$.data.orchard.play.running",
                        "is": false
                    },
                    "to": "idle"
                },
                {
                    "from": "dropping",
                    "when": {
                        "after": 1500
                    },
                    "do": [
                        {
                            "command": "set",
                            "target": "$.data.orchard.fruit.f{{ $.data.orchard.next }}",
                            "value": {
                                "at": [
                                    "{{ ($.data.orchard.next * 7) % 9 - 4 }}",
                                    6,
                                    0
                                ],
                                "speed": [
                                    0,
                                    0,
                                    0
                                ]
                            }
                        },
                        {
                            "command": "increment",
                            "target": "$.data.orchard.next"
                        }
                    ],
                    "to": "dropping"
                }
            ]
        }
    }
}
